#include <stdio.h>
#include <time.h>

int main()
{
    int year, i, j, days[12];
    int start_day;
    
    char *months[] = {
        "January", "February", "March",
        "April", "May", "June",
        "July", "August", "September",
        "October", "November", "December"
    };

    int month_days[] = {
        31, 28, 31, 30, 31, 30,
        31, 31, 30, 31, 30, 31
    };

    struct tm date = {0};

    printf("Enter year: ");
    scanf("%d", &year);

    if (year < 1900 || year > 9999)
    {
        printf("Invalid year");
        return 0;
    }

    /* Check leap year */
    if ((year % 400 == 0) ||
        (year % 4 == 0 && year % 100 != 0))
    {
        month_days[1] = 29;
    }

    /* Find the first day of the year */
    date.tm_year = year - 1900;
    date.tm_mon = 0;
    date.tm_mday = 1;
    date.tm_isdst = -1;

    if (mktime(&date) == (time_t)-1)
    {
        printf("Unable to generate calendar");
        return 1;
    }

    start_day = date.tm_wday;

    /* Print all 12 months */
    for (i = 0; i < 12; i++)
    {
        printf("\n\n       %s %d\n", months[i], year);
        printf("Sun Mon Tue Wed Thu Fri Sat\n");

        for (j = 0; j < start_day; j++)
        {
            printf("    ");
        }

        for (j = 1; j <= month_days[i]; j++)
        {
            printf("%3d ", j);

            if ((start_day + j) % 7 == 0)
            {
                printf("\n");
            }
        }

        start_day = (start_day + month_days[i]) % 7;
    }

    return 0;
}
