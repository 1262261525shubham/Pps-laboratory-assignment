#include <stdio.h>

long long factorial_iterative(int n)
{
    long long fact = 1;
    int i;

    for (i = 1; i <= n; i++)
    {
        fact = fact * i;
    }

    return fact;
}

long long factorial_recursive(int n)
{
    if (n == 0 || n == 1)
        return 1;

    return n * factorial_recursive(n - 1);
}

int main()
{
    int n, choice;

    printf("Enter a number: ");
    scanf("%d", &n);

    if (n < 0 || n > 20)
    {
        printf("Enter a number between 0 and 20.\n");
        return 0;
    }

    printf("\n1. Factorial without recursion");
    printf("\n2. Factorial with recursion");

    printf("\nEnter your choice: ");
    scanf("%d", &choice);

    switch (choice)
    {
        case 1:
            printf("Factorial = %lld\n", factorial_iterative(n));
            break;

        case 2:
            printf("Factorial = %lld\n", factorial_recursive(n));
            break;

        default:
            printf("Invalid choice!\n");
    }

    return 0;
}
