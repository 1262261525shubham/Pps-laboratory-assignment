#include <stdio.h>
#include <string.h>

int main()
{
    char email[50], password[50];

    char correct_email[] = "user@gmail.com";
    char correct_password[] = "123456";

    printf("Enter Gmail ID: ");
    scanf("%49s", email);

    printf("Enter Password: ");
    scanf("%49s", password);

    if (strcmp(email, correct_email) == 0 &&
        strcmp(password, correct_password) == 0)
    {
        printf("\nLogin Successful!\n");
    }
    else
    {
        printf("\nInvalid Gmail ID or Password!\n");
    }

    return 0;
}
